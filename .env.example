# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# DATABASE_URL → Transaction Pooler (port 6543) — used by the app at runtime
# DIRECT_URL   → Session Pooler (port 5432)    — used by drizzle-kit for migrations only
DATABASE_URL=postgresql://postgres.ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# SerpAPI (https://serpapi.com)
SERP_API_KEY=your-serpapi-key

# Resend (https://resend.com) — for rank change alerts
RESEND_API_KEY=your-resend-key

# Cron security — any random secret string; set same value in Vercel env vars
CRON_SECRET=your-cron-secret
